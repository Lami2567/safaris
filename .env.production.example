# ==============================================================================
# SAFARIS Backend - Production Environment Configuration Template (.env.production)
# ==============================================================================
# INSTRUCTIONS FOR AWS LIGHTSAIL VPS:
# 1. Copy this file to .env.production on the VPS:
#    cp .env.production.example .env.production
# 2. Generate strong secrets using OpenSSL:
#    openssl rand -hex 32
# 3. Replace all placeholder values below with your generated secrets.
# 4. NEVER commit your actual .env.production file to version control.
# ==============================================================================

PORT=3000
NODE_ENV=production

# Database Configuration (Docker network service name is 'postgres')
DB_HOST=postgres
DB_PORT=5432
DB_USER=safaris_prod_user
DB_PASSWORD=GENERATE_SECURE_PASSWORD_HERE
DB_NAME=safaris_production
DATABASE_URL=postgres://safaris_prod_user:GENERATE_SECURE_PASSWORD_HERE@postgres:5432/safaris_production

# Redis Configuration (Docker network service name is 'redis')
REDIS_URL=redis://redis:6379

# JWT & Authentication Security (Minimum 32 random characters)
# Generate via: openssl rand -hex 32
JWT_SECRET=GENERATE_SECURE_RANDOM_SECRET_HERE
JWT_EXPIRES_IN=24h
REFRESH_TOKEN_SECRET=GENERATE_SECURE_RANDOM_SECRET_HERE
REFRESH_TOKEN_EXPIRES_IN=30d

# Cross-Origin Resource Sharing (Comma separated or * for mobile Flutter clients)
CORS_ORIGIN=*

# Seeding (Keep false in production to prevent automated test data overwrites)
AUTO_SEED=false

# Uganda Localization & Payment Defaults
DEFAULT_COUNTRY=Uganda
DEFAULT_CURRENCY=UGX
# Keep true for initial VPS staging and Flutter integration testing
PAYMENT_MOCK_MODE=true

# Mobile App Remote Config & Version Enforcement
MIN_APP_VERSION=1.0.0
LATEST_APP_VERSION=1.0.0
FORCE_UPDATE=false
MAINTENANCE_MODE=false

# DPO Pay (Direct Pay Online) Production Gateway Configuration
# Set DPO_ENVIRONMENT=production for live production merchant account
DPO_ENVIRONMENT=production
DPO_API_BASE_URL=https://secure.3gdirectpay.com/API/v6/
DPO_PAY_URL=https://secure.3gdirectpay.com/payv3.php
DPO_COMPANY_TOKEN=YOUR_DPO_PRODUCTION_COMPANY_TOKEN
DPO_SERVICE_TYPE=YOUR_DPO_SERVICE_TYPE
DPO_CALLBACK_URL=https://admin.mumwesafarisuganda.com/api/v1/payments/dpo/callback
DPO_CANCEL_URL=https://admin.mumwesafarisuganda.com/api/v1/payments/dpo/cancel

# Careers Recruitment Portal Integration (careers.mumwesafarisuganda.com)
CAREERS_API_SECRET=GENERATE_SECURE_CAREERS_SECRET_HERE

