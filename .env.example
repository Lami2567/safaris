# SAFARIS Platform Environment Configuration
PORT=3000
NODE_ENV=development

# Database
# For local host development (outside Docker): DB_HOST=localhost
# For Docker Compose: DB_HOST=postgres
DATABASE_URL=postgres://safaris_user:safaris_secure_password@localhost:5432/safaris_db
DB_HOST=localhost
DB_PORT=5432
DB_USER=safaris_user
DB_PASSWORD=safaris_secure_password
DB_NAME=safaris_db

# Redis
# For local host development: REDIS_URL=redis://localhost:6379
# For Docker Compose: REDIS_URL=redis://redis:6379
REDIS_URL=redis://localhost:6379

# Security
JWT_SECRET=safaris_dev_jwt_secret_key_uganda_2026
JWT_EXPIRES_IN=7d
REFRESH_TOKEN_SECRET=safaris_dev_refresh_secret_key_uganda_2026
REFRESH_TOKEN_EXPIRES_IN=30d

# Cross-Origin Resource Sharing
CORS_ORIGIN=*

# Seeding (true automatically loads Uganda mobility & tourism test data)
AUTO_SEED=true

# Uganda Localization & Payment Defaults
DEFAULT_COUNTRY=Uganda
DEFAULT_CURRENCY=UGX
PAYMENT_MOCK_MODE=true

# Mobile App Remote Config
MIN_APP_VERSION=1.0.0
LATEST_APP_VERSION=1.0.0
FORCE_UPDATE=false
MAINTENANCE_MODE=false

# Mapbox Cartography & Fleet Telemetry (Public Access Token)
MAPBOX_ACCESS_TOKEN=

# DPO Pay (Direct Pay Online) Official Gateway Configuration (Ticket #2777504)
# Default to 'sandbox' during integration validation. Only switch to 'production' after DPO issues live credentials.
DPO_ENVIRONMENT=sandbox
DPO_SUPPORT_TICKET_REF=2777504

# Sandbox Credentials (supplied in DPO support email; never hardcode in source code)
DPO_SANDBOX_COMPANY_TOKEN=YOUR_DPO_SANDBOX_COMPANY_TOKEN
DPO_SANDBOX_SERVICE_TYPE_ID=54841

# Live Production Credentials (leave blank until supplied and confirmed by DPO; do not assume 54841 applies to live)
DPO_LIVE_COMPANY_TOKEN=
DPO_LIVE_SERVICE_TYPE_ID=
DPO_LIVE_ACTIVATION_CONFIRMED=false

# DPO API v6 & Hosted Checkout Endpoints
DPO_API_BASE_URL=https://secure.3gdirectpay.com/API/v6/
DPO_PAY_URL=https://secure.3gdirectpay.com/payv3.php
DPO_CALLBACK_URL=https://admin.mumwesafarisuganda.com/api/v1/payments/dpo/callback
DPO_CANCEL_URL=https://admin.mumwesafarisuganda.com/api/v1/payments/dpo/cancel

# Careers Recruitment Integration (careers.mumwesafarisuganda.com)
CAREERS_API_SECRET=YOUR_CAREERS_API_SECRET_HERE

